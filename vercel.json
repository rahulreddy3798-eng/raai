{
"services": {
"frontend": {
"root": "frontend",
"framework": "vite"
},
"backend": {
"root": "backend",
"framework": "fastapi",
"entrypoint": "app/main.py"
}
},
"rewrites": [
{ "source": "/api/:path*", "destination": "backend/:path*" },
{ "source": "/:path*", "destination": "frontend/:path*" }
]
}

